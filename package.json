{
  "name": "hibiki-desktop",
  "version": "3.0.0",
  "description": "hibiki is a anime client: browse installable sources, search with filters, watch in a built-in player, download episodes for offline viewing, and keep a library with progress and achievements.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "hibiki",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "build:unpack": "tsc -b && vite build && electron-builder --dir",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:main": "vitest run --config vitest.main.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "probe": "tsx scripts/probe-source.ts",
    "android:build": "vite build -c vite.android.config.ts && cap sync android",
    "android:apk": "npm run android:build && cd android && gradlew assembleDebug",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.114.0",
    "@tanstack/react-virtual": "^3.14.11",
    "@xhayper/discord-rpc": "^1.3.4",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "dashjs": "^5.2.1",
    "discord-api-types": "^0.38.55",
    "drizzle-orm": "^0.39.3",
    "hls.js": "^1.5.20",
    "i18next": "^26.4.1",
    "lucide-react": "^1.39.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.13",
    "sync-fetch": "^0.6.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.50.1",
    "@tanstack/router-plugin": "^1.114.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "buffer": "^6.0.3",
    "drizzle-kit": "^0.30.4",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "fflate": "^0.8.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.5"
  }
}
